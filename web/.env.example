# Ajustes de Neuri, el asistente de «Estudiar». Copia este archivo como .env.local (git no lo guarda) y rellénalo.

# Clave de la API de Anthropic (empieza por sk-ant-). Sin clave, Neuri responde con el buscador de la app.
# Créala en platform.claude.com con un límite de gasto mensual.
ANTHROPIC_API_KEY=

# Modelo de Claude para la conversación (opcional). Por defecto claude-haiku-5-5, el más barato. Otra opción:
# claude-sonnet-5-5 (unas 20 veces más caro). Opus no se usa en la app: es caro (solo para desarrollar); si se pone, se
# ignora (y también Fable y Mythos).
ANATO3D_PET_MODELO=

# Modelo para planificar, redactar y adaptar lecciones (opcional). Por defecto, el de arriba.
ANATO3D_PET_MODELO_LECCIONES=
